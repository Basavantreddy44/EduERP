  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([tenantId, inventoryItemId])
  @@map("diet_scale_items")
}

/// Children who ate each meal on a day, by class, at one campus (G3).
model MealCount {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  campusId   String   @map("campus_id") @db.Uuid
  mealDate   DateTime @map("meal_date") @db.Date
  levelName  String   @map("level_name") @db.VarChar(50)
  breakfast  Int      @default(0)
  lunch      Int      @default(0)
  snacks     Int      @default(0)
  dinner     Int      @default(0)
  updatedBy  String?  @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([tenantId, campusId, mealDate, levelName])
  @@index([tenantId, campusId, mealDate])
  @@map("meal_counts")
}
