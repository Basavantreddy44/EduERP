{
  "name": "@eduerp/db",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate:new": "dotenv -e ../../.env -- node scripts/new-migration.mjs",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- node dist/seed.js"
  },
  "dependencies": {
    "@eduerp/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "~6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv-cli": "^8.0.0",
    "prisma": "~6.19.0",
    "typescript": "~5.8.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
