{
  "name": "@eduerp/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "test": "dotenv -e ../../.env -- jest --runInBand",
    "openapi:export": "dotenv -e ../../.env -- node dist/openapi-export.js",
    "worker": "dotenv -e ../../.env -- node dist/worker/main.js",
    "jobs:setup": "dotenv -e ../../.env -- node dist/worker/jobs-setup.main.js"
  },
  "dependencies": {
    "@eduerp/db": "workspace:*",
    "@eduerp/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.8",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^6.10.1",
    "pg-boss": "^10.4.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "typescript": "~5.8.3"
  }
}
