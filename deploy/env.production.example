# Copy to deploy/.env on the server and fill in every value. Never commit the real file.
# Generate secrets on the server with:  openssl rand -base64 48

# Domain for the API (DNS A record → this server's IP), e.g. api.yourschool.in
API_DOMAIN=api.example.in
# Where the web screens live (your Vercel address or custom domain). Used for CORS and email links.
WEB_ORIGIN=https://eduerp-demo.vercel.app

NODE_ENV=production
API_PORT=4000

# Database passwords (long random strings; letters and digits only keep the URLs simple).
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=

# Login tokens — at least 32 characters:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Encryption of PAN / bank numbers / counselling notes (CD-84) — 32 random bytes:  openssl rand -base64 32
# Keep a copy somewhere safe: data encrypted with it cannot be read without it.
FIELD_ENCRYPTION_KEY=

# First platform administrator (used by the seed on first run only).
SEED_ADMIN_EMAIL=you@example.in
SEED_ADMIN_PASSWORD=

# Email (an SMTP service such as Amazon SES, Zoho ZeptoMail, Brevo or Gmail SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EduERP <no-reply@example.in>"

# Uploaded files (mounted volume — do not change).
STORAGE_DRIVER=local
FILES_DIR=/data/files

# Online fee payment: leave off until the owner adds Razorpay keys.
PAYMENT_GATEWAY=off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# API documentation page (/api/docs): off on a public server.
API_DOCS=off
