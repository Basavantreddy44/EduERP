# Copy to .env for local development. Values below are LOCAL-DEV ONLY placeholders.
# Never commit a real .env. Production secrets come from the secret manager.

POSTGRES_PORT=5433
POSTGRES_OWNER_USER=eduerp_owner
POSTGRES_OWNER_PASSWORD=change_me_owner
POSTGRES_APP_PASSWORD=change_me_app
POSTGRES_DB=eduerp

# Migrations run as the owner role. The API runs as eduerp_app (no BYPASSRLS).
DATABASE_OWNER_URL=postgresql://eduerp_owner:change_me_owner@localhost:5433/eduerp
DATABASE_URL=postgresql://eduerp_app:change_me_app@localhost:5433/eduerp?connection_limit=15&pool_timeout=20
# Integration tests use a separate database.
TEST_DATABASE_OWNER_URL=postgresql://eduerp_owner:change_me_owner@localhost:5433/eduerp_test
TEST_DATABASE_URL=postgresql://eduerp_app:change_me_app@localhost:5433/eduerp_test

REDIS_PORT=6380

API_PORT=4000
WEB_PORT=3100
WEB_ORIGIN=http://localhost:3100
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_random_48_bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Seed (local only): first platform super admin
SEED_ADMIN_EMAIL=admin@eduerp.local
SEED_ADMIN_PASSWORD=ChangeMe@12345
# API_DOCS=on   # serve Swagger UI at /api/docs even in production (default: on outside production)

# Files (local disk in dev; S3 driver comes with infra)
STORAGE_DRIVER=local
FILES_DIR=./var/files

# Email (Mailpit: inbox UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="EduERP <no-reply@eduerp.local>"

# Background jobs
JOBS_RETRY_LIMIT=5
JOBS_RETRY_DELAY_SECONDS=10
OUTBOX_POLL_MS=1000

# Online payment (Razorpay). Leave the keys empty to use the simulated gateway in development.
# Use Razorpay TEST keys until go-live. Never commit real keys.
# PAYMENT_GATEWAY=razorpay        # razorpay | simulated | off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RECONCILE_SECONDS=300

# Field-level encryption for bank account numbers and PAN (CD-84): 32 random bytes in base64.
# Generate with:  openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Required in production. In development, if empty, a key is derived from JWT_ACCESS_SECRET.
# Never commit a real key; keep it safe — data encrypted with it cannot be read without it.
FIELD_ENCRYPTION_KEY=
